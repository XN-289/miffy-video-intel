# Feishu app credentials. Keep this file local; .env is ignored by Git.
FEISHU_APP_ID=replace_with_feishu_app_id
FEISHU_APP_SECRET=replace_with_feishu_app_secret

# Existing Bitable target.
FEISHU_BASE_ID=replace_with_bitable_app_token
FEISHU_TABLE_ID=replace_with_bitable_table_id

# Optional: send a short group notification after each upsert.
FEISHU_CHAT_ID=

# Optional model metadata written to each record.
MIFFY_DEFAULT_AGENT=Muse
MIFFY_DEFAULT_MODEL=

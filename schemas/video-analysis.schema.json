{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://miffy.local/schemas/video-analysis.schema.json",
  "title": "Miffy complete video analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "video", "collection", "analysis", "shop_action"],
  "properties": {
    "schema_version": { "const": 1 },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "platform", "title", "content"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "platform": { "enum": ["xiaohongshu", "douyin", "channels", "other"] },
        "title": { "type": "string", "minLength": 2 },
        "author": { "type": "string" },
        "published_at": { "type": "string" },
        "description": { "type": "string" },
        "cover_url": { "type": "string" },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "likes": { "type": "number", "minimum": 0 },
            "collects": { "type": "number", "minimum": 0 },
            "comments": { "type": "number", "minimum": 0 },
            "shares": { "type": "number", "minimum": 0 }
          }
        },
        "metrics_text": { "type": "string" },
        "product": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "price_range": { "type": "string" },
            "selling_points": { "type": "array", "items": { "type": "string" } },
            "purchase_path": { "type": "string" }
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "likes": { "type": "number", "minimum": 0 },
              "insight": { "type": "string" }
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transcript": { "type": "string", "minLength": 30 },
            "visual_notes": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string", "minLength": 4 }
            }
          },
          "anyOf": [
            { "required": ["transcript"] },
            { "required": ["visual_notes"] }
          ]
        },
        "evidence_images": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "timestamp_seconds", "label"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "timestamp_seconds": { "type": "number", "minimum": 0 },
              "label": { "type": "string", "minLength": 2 }
            }
          }
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "method", "evidence", "missing"],
      "properties": {
        "access": { "enum": ["visible", "partial"] },
        "method": {
          "enum": ["agent_browser", "user_browser", "screenshots", "manual_materials", "mixed"]
        },
        "collector_agent": { "type": "string" },
        "model": { "type": "string" },
        "collected_at": { "type": "string" },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "quote", "confidence"],
            "properties": {
              "source": {
                "enum": ["page", "screenshot", "transcript", "comments", "product_page", "user_input"]
              },
              "quote": { "type": "string", "minLength": 2 },
              "confidence": { "enum": ["high", "medium", "low"] }
            }
          }
        },
        "missing": { "type": "array", "items": { "type": "string" } }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "why_viral",
        "scores",
        "hook",
        "content_structure",
        "product_scene_fit",
        "audience",
        "conversion_path",
        "reusable_patterns"
      ],
      "properties": {
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hook_strength", "product_scene_fit", "conversion_strength", "replicability", "overall"],
          "properties": {
            "hook_strength": { "type": "number", "minimum": 1, "maximum": 5 },
            "product_scene_fit": { "type": "number", "minimum": 1, "maximum": 5 },
            "conversion_strength": { "type": "number", "minimum": 1, "maximum": 5 },
            "replicability": { "type": "number", "minimum": 1, "maximum": 5 },
            "overall": { "type": "number", "minimum": 1, "maximum": 5 }
          }
        },
        "why_viral": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": "string", "minLength": 8 } },
        "hook": { "type": "string", "minLength": 12 },
        "content_structure": { "type": "array", "minItems": 3, "maxItems": 7, "items": { "type": "string", "minLength": 4 } },
        "product_scene_fit": { "type": "string", "minLength": 20 },
        "audience": { "type": "string", "minLength": 10 },
        "conversion_path": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string" } },
        "reusable_patterns": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string" } },
        "comment_insight": { "type": "string" }
      }
    },
    "shop_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_actions", "shooting_script", "risks", "confidence"],
      "properties": {
        "benchmark_actions": { "type": "array", "minItems": 3, "maxItems": 7, "items": { "type": "string", "minLength": 6 } },
        "shooting_script": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration_seconds", "hook", "scenes", "cta"],
          "properties": {
            "duration_seconds": { "type": "number", "minimum": 5, "maximum": 600 },
            "hook": { "type": "string", "minLength": 8 },
            "scenes": { "type": "array", "minItems": 3, "maxItems": 12, "items": { "type": "string", "minLength": 4 } },
            "cta": { "type": "string", "minLength": 4 }
          }
        },
        "risks": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string" } },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    }
  }
}
